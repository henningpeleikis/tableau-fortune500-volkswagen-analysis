                <zone fixed-size='280' h='41667' id='96' is-fixed='true' name='Stock Price' w='42500' x='6250' y='16667'>
                  <layout-cache minwidth='162' type-h='fixed' type-w='scalable' />
                  <zone-style>
                    <format attr='border-color' value='#000000' />
