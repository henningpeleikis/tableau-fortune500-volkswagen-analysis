      <aliases enabled='yes' />
      <column caption='Count Countries' datatype='integer' name='[Calculation_1289155394948173824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([country])' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_1289155394949365761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country] : COUNTD([name]) }   // or COUNTD([name]) if no aliases' />
      </column>
      <column caption='Revchange_Positive_Negative' datatype='string' name='[Calculation_1289155394959482883]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [revchange] &gt; 0 THEN &quot;Positive&quot;&#13;&#10;ELSEIF [revchange] &lt; 0 THEN &quot;Negative&quot;&#13;&#10;ELSE &quot;No Change&quot;&#13;&#10;END' />
      </column>
      <column caption='Profitability' datatype='real' name='[Calculation_1289155394969153540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1289155394971049990]/[Calculation_1289155394970808325]' />
      </column>
      <column caption='Revenue Scaled' datatype='real' name='[Calculation_1289155394970808325]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[revenues]*1000000' />
      </column>
      <column caption='Profits Scaled' datatype='real' name='[Calculation_1289155394971049990]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[profits]*1000000' />
      </column>
      <column caption='Profits_Positive_Negative' datatype='string' name='[Calculation_1289155394974187527]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [profits] &gt; 0 THEN &quot;Profitable&quot;&#13;&#10;ELSEIF [profits] &lt; 0 THEN &quot;Unprofitable&quot;&#13;&#10;ELSE &quot;Breakeven&quot;&#13;&#10;END' />
      </column>
      <column caption='Profitability_Positive_Negative' datatype='string' name='[Calculation_1289155394974769161]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1289155394969153540] &gt; 0 THEN &quot;Profitable&quot;&#13;&#10;ELSEIF [Calculation_1289155394969153540] &lt; 0 THEN &quot;Unprofitable&quot;&#13;&#10;ELSE &quot;Breakeven&quot;&#13;&#10;END' />
      </column>
      <column caption='MIN_COMPANY' datatype='integer' name='[Calculation_1289155394983505934]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [name] : MIN(1) }' />
      </column>
      <column caption='Unique_Company_Count_' datatype='integer' name='[Calculation_1289155394983645199]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( { FIXED [name] : MIN(1) } )' />
      </column>
      <column caption='ZERO' datatype='integer' name='[Calculation_1289155394994315280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Revenue_for_Rank' datatype='real' name='[Calculation_1728537834019446786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Revenue_for_Rank&#13;&#10;{ FIXED [name] : SUM([Calculation_1289155394970808325]) }' />
      </column>
      <column caption='% Total Revenue' datatype='real' name='[Calculation_1728537834025689092]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1289155394970808325]) / TOTAL(SUM([Calculation_1289155394970808325]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Grouping &lt; 2%' datatype='string' name='[Calculation_1728537834025840645]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1728537834025689092] &lt; 0.02 THEN &quot;Others&quot; ELSE ATTR([name]) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Newcomer Text' datatype='string' name='[Calculation_385339249486741504]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;No: &quot; + STR(SUM(IIF([newcomer] = &quot;no&quot;, 1, 0))) +&#13;&#10;&quot;     Yes: &quot; + STR(SUM(IIF([newcomer] = &quot;yes&quot;, 1, 0)))' />
      </column>
      <column caption='Sector Revenue' datatype='real' name='[Calculation_385339249612640258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [year], [sector] : SUM([Calculation_1289155394970808325]) }' />
      </column>
      <column caption='VW vs Sector' datatype='string' name='[Calculation_385339249614344196]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [name] = &quot;Volkswagen&quot; THEN &quot;Volkswagen&quot;&#13;&#10;ELSE &quot;Sector Total&quot;&#13;&#10;END' />
      </column>
      <column datatype='string' name='[Name (group)]' role='dimension' type='nominal'>
